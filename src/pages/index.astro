---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PetCard from '../components/PetCard.astro';
import { getApprovedPets } from '../lib/pets';
import { DISTRICTS } from '../lib/areas';

const pets = await getApprovedPets();
const recent = pets.slice(0, 3);
const mapPoints = pets.map((p) => ({ lat: p.lat, lng: p.lng, name: p.name, status: p.status }));

const site = Astro.site!.toString().replace(/\/$/, '');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Find My Pet Cyprus', url: `${site}/`, logo: `${site}/assets/photo.jpg` },
  {
    '@context': 'https://schema.org', '@type': 'WebSite', name: 'Find My Pet Cyprus', url: `${site}/`,
    potentialAction: { '@type': 'SearchAction', target: `${site}/search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
  },
];
---
<Base title="Find My Pet Cyprus — report and search missing & found pets" leaflet jsonLd={jsonLd}>
  <Nav />
  <div class="wrap">
    <section class="hero">
      <div>
        <h1 class="display">
          <span class="line">A missing pet is</span>
          <span class="line">an emergency.</span>
          <span class="line">We keep it calm.</span>
        </h1>
        <p class="sub">Search a live map of missing and found pets across Cyprus, or report one in a few minutes — photos, last-seen area, and a description. Every listing is checked by a moderator before it goes public, so the map stays trustworthy when it matters most.</p>
        <div class="row">
          <a href="/search" class="btn btn-primary">Search the map</a>
          <a href="/submit" class="btn btn-secondary">Report missing or found</a>
        </div>
      </div>
      <div class="hero-map" aria-label="Map of recent listings across Cyprus">
        <div id="hero-leaflet"></div>
        <div class="legend"><span><i class="missing"></i>Missing</span><span><i class="found"></i>Found</span></div>
      </div>
    </section>

    <section class="steps" id="how">
      <span class="kicker">How it works</span>
      <div class="grid">
        <div class="step"><span class="num">1</span><h3>Report</h3><p>Add photos, a description and the area last seen. Takes a few minutes, no account required to start.</p></div>
        <div class="step"><span class="num">2</span><h3>Checked</h3><p>A moderator reviews every listing before it's public — keeps the map free of spam and duplicates.</p></div>
        <div class="step"><span class="num">3</span><h3>Reunited</h3><p>Anyone searching nearby — by postcode, area, or radius from a point — can find it and get in touch.</p></div>
      </div>
    </section>

    <section class="recent">
      <div class="recent-head">
        <h2>Recently reported nearby</h2>
        <a href="/search" class="btn btn-ghost">See all on the map →</a>
      </div>
      <div class="pet-grid">
        {recent.map((pet) => <PetCard pet={pet} />)}
      </div>
    </section>

    <section class="areas" id="areas">
      <span class="kicker">Browse by area</span>
      <h2>Missing &amp; found pets across Cyprus</h2>
      <div class="area-chips">
        {DISTRICTS.map((d) => (
          <a class="chip" href={`/area/${d.slug}`}>{d.short}</a>
        ))}
      </div>
    </section>

    <section class="close" id="join">
      <div class="patch">
        <div class="copy">
          <h3>Missing a pet right now?</h3>
          <p class="sub">Don't wait — a listing takes a few minutes, and the sooner it's checked and live, the sooner someone nearby can spot it.</p>
        </div>
        <div class="row">
          <a href="/submit" class="btn btn-primary">Report now</a>
          <a href="/search" class="btn btn-secondary">Search the map</a>
        </div>
      </div>
    </section>

    <Footer />
  </div>

  <script is:inline define:vars={{ mapPoints }}>
    (function () {
      if (typeof L === 'undefined') return;
      var map = L.map('hero-leaflet', { zoomControl: false, dragging: false, scrollWheelZoom: false, doubleClickZoom: false, touchZoom: false, attributionControl: false }).setView([34.98, 33.15], 8.4);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
      mapPoints.forEach(function (p) {
        var color = p.status === 'missing' ? '#c67139' : '#7a8a5e';
        L.marker([p.lat, p.lng], { icon: L.divIcon({ className: '', html: '<div style="width:14px;height:14px;border-radius:50%;background:' + color + ';border:3px solid #f5ead8;box-shadow:0 1px 3px rgba(0,0,0,.3)"></div>', iconSize: [14, 14], iconAnchor: [7, 7] }) }).addTo(map).bindTooltip(p.name);
      });
      map.on('click', function () { window.location.href = '/search'; });
    })();
  </script>

  <style>
    .wrap { max-width: 1200px; margin: 0 auto; padding: 0 var(--edge, clamp(20px, 5vw, 72px)); }
    .kicker { display: block; font-size: 13px; line-height: 14px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; color: var(--color-accent-700); margin: 0 0 14px; }

    .hero { position: relative; padding: 84px 0 70px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 28px clamp(24px, 5vw, 72px); align-items: center; }
    .hero::before { content: ""; position: absolute; right: -180px; top: -220px; width: 420px; height: 420px; border-radius: 50%; background: var(--color-accent-2-200); pointer-events: none; z-index: -1; }
    @media (max-width: 1420px) { .hero::before { right: 0; } }
    @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }

    .display { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(38px, 5.2vw, 66px); line-height: clamp(41px, 5.6vw, 71px); letter-spacing: 0; margin: 0; margin-left: -0.028em; }
    .display .line { display: block; }
    .hero .sub { font-size: 17px; line-height: 28px; max-width: 58ch; margin: 20px 0 0; }
    .hero .row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: 28px; }
    .hero .row .btn { min-height: 44px; padding-inline: var(--space-4); font-size: 14px; }

    .hero-map { border-radius: calc(2 * var(--radius-lg)); overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 4/3; position: relative; background: var(--color-surface); }
    .hero-map #hero-leaflet { position: absolute; inset: 0; }
    .hero-map .legend { position: absolute; left: var(--space-3); bottom: var(--space-3); display: flex; gap: var(--space-3); background: color-mix(in srgb, var(--color-bg) 88%, transparent); padding: var(--space-2) var(--space-3); border-radius: 999px; font-size: 12px; }
    .hero-map .legend span { display: inline-flex; align-items: center; gap: 6px; }
    .hero-map .legend i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
    .hero-map .legend i.missing { background: var(--color-accent); }
    .hero-map .legend i.found { background: var(--color-accent-2); }

    .steps { padding: 70px 0; }
    .steps .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px clamp(20px, 3vw, 48px); }
    @media (max-width: 780px) { .steps .grid { grid-template-columns: 1fr; } }
    .step { position: relative; padding-left: 44px; }
    .step .num { position: absolute; left: 0; top: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--color-accent); color: var(--color-bg); display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 15px; }
    .step h3 { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 21px; margin: 0 0 6px; }
    .step p { font-size: 14.5px; line-height: 1.6; margin: 0; color: color-mix(in srgb, var(--color-text) 78%, transparent); max-width: 40ch; }

    .recent { padding: 56px 0 70px; }
    .recent-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); margin-bottom: 28px; flex-wrap: wrap; }
    .recent-head h2 { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 30px; margin: 0; }
    .pet-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
    @media (max-width: 980px) { .pet-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 620px) { .pet-grid { grid-template-columns: 1fr; } }

    .areas { padding: 0 0 56px; }
    .areas h2 { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 30px; margin: 0 0 20px; }
    .area-chips { display: flex; flex-wrap: wrap; gap: var(--space-3); }
    .area-chips .chip { text-decoration: none; font-size: 14px; padding: 10px 18px; border-radius: 999px; background: var(--color-surface); color: var(--color-text); transition: background .15s; }
    .area-chips .chip:hover { background: var(--color-accent-100); color: var(--color-accent-800); }

    .close { padding: 0 0 56px; }
    .patch { background: var(--color-accent-2-100); border-radius: calc(2 * var(--radius-lg)); padding: 56px clamp(24px, 4vw, 64px); display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
    .patch .copy { max-width: 44ch; }
    .patch h3 { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 26px; margin: 0; }
    .patch .sub { font-size: 15.5px; line-height: 28px; color: color-mix(in srgb, var(--color-text) 78%, transparent); margin: 12px 0 0; }
    .patch .row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
    .patch .btn { min-height: 44px; padding-inline: var(--space-4); }
  </style>
</Base>
